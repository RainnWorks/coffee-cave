{
  "name": "@coffeecave/zero",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "dmno run -- bun run src/index.ts",
    "dev:server": "dmno run -- bun --hot run src/index.ts",
    "dev:zero-cache": "dmno run -- zero-cache-dev -p src/schema.ts",
    "dev:zero-cache:clean": "dmno run -- rm -f \"$ZERO_REPLICA_FILE*\"",
    "dev:frontend": "dmno run -- vite serve ./src/frontend",
    "dev:db-up": "dmno run -- docker compose -f ./docker/docker-compose.yml up -d --wait db",
    "dev:db-reset": "dmno run -- prisma migrate reset --force && dmno run -- bun run script/seed.ts",
    "dev:db-migrate": "dmno run -- prisma migrate dev --name init",
    "dev:db-clean": "dmno run -- docker volume rm -f docker_zstart_pgdata",
    "dev:db-down": "dmno run -- docker compose -f ./docker/docker-compose.yml down",
    "dev:seed": "dmno run -- bun run script/seed.ts",
    "dev:all": "bun run dev:zero-cache:clean && bun run dev:db-down && bun run dev:db-clean && bun run dev:db-up && bun run dev:db-reset && bun run ./script/dev.ts",
    "dev": "dmno run -w -- bun run dev:all",
    "prisma:generate": "dmno run -- prisma generate",
    "prisma:migrate": "dmno run -- prisma migrate"
  },
  "devDependencies": {
    "@passionfroot/prisma-generator-zero": "^0.4.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^9.2.0",
    "prisma": "6.13.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.6"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@adminjs/prisma": "^5.0.4",
    "@adminjs/sequelize": "^4.1.1",
    "@dmno/vite-integration": "^0.0.16",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/eden": "^1.3.2",
    "@elysiajs/jwt": "^1.3.2",
    "@elysiajs/static": "^1.3.0",
    "@prisma/client": "6.13.0",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.13",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@rocicorp/zero": "^0.22.2025080200",
    "@tailwindcss/vite": "^4.1.11",
    "@tiptap/extension-horizontal-rule": "2.1.13",
    "@vitejs/plugin-react": "^4.7.0",
    "adminjs": "^7.8.17",
    "argon2": "^0.43.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dmno": "^0.0.39",
    "elysia": "^1.3.8",
    "elysia-connect-middleware": "^0.0.6",
    "elysia-rate-limit": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "isbot": "^5",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.539.0",
    "nanoid": "^5.1.5",
    "nuqs": "^2.4.3",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sequelize": "^6.37.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6",
    "ulid": "^3.0.1",
    "wouter": "^3.7.1"
  }
}
